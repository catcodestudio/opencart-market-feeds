                </div>
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_llms_products }}</label>
                  <div class="col-sm-9"><input type="number" min="0" max="500" name="module_cc_feeds_llms_products" value="{{ llms_products }}" class="form-control" style="max-width:140px"/></div>
                </div>
                <div class="row mb-3">
                  <label class="col-sm-3 col-form-label">{{ entry_llms_summary }}</label>
                  <div class="col-sm-9"><textarea name="module_cc_feeds_llms_summary" rows="3" maxlength="500" class="form-control">{{ llms_summary }}</textarea><div class="form-text">{{ help_llms_summary }}</div></div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_ai_ucp }}</legend>
                <div class="row mb-3">
