                  </div><div class="form-text">{{ help_ucp }}</div>
                  {% if not ucp_https %}<div class="alert alert-warning mt-2">{{ warning_ucp_https }}</div>{% elseif not ucp_at_root %}<div class="alert alert-warning mt-2">{{ warning_ucp_root }}</div>{% endif %}
                  <input type="text" class="form-control mt-1" readonly value="{{ url_ucp }}" onclick="this.select()"/>
                  <input type="text" class="form-control mt-1" readonly value="{{ url_ucp_rest }}" onclick="this.select()"/></div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_ai_server }}</legend>
                <p>{{ help_ai_server }}</p>
                <p><button type="button" id="btn-agent-check" class="btn btn-outline-primary"><i class="fa-solid fa-stethoscope"></i> {{ button_agent_check }}</button></p>
                <div id="agent-check-result"></div>
                <p class="mb-1"><strong>Apache (.htaccess)</strong></p>
                <pre class="bg-light p-2" style="white-space:pre-wrap">{{ snippet_apache|e }}</pre>
                <p class="mb-1"><strong>nginx</strong></p>
                <pre class="bg-light p-2" style="white-space:pre-wrap">{{ snippet_nginx|e }}</pre>
              </fieldset>
            </div>

          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
// Twig html-escapes controller URLs (& -> &amp;) which breaks fetch()
// targets: the user token is lost and the login page comes back as HTML.
function ccUrl(s) { return s.replace(/&amp;/g, '&'); }

document.getElementById('form-feeds').addEventListener('submit', function(e) {
  e.preventDefault();
  var alertBox = document.getElementById('alert-feeds');
  fetch(ccUrl('{{ save }}'), { method: 'POST', body: new FormData(this) })
    .then(function(r) { return r.json(); })
    .then(function(json) {
      if (json.error) {
        alertBox.innerHTML = '<div class="alert alert-danger">' + json.error + '</div>';
      } else if (json.success) {
        alertBox.innerHTML = '<div class="alert alert-success">' + json.success + '</div>';
      }
      window.scrollTo(0, 0);
    });
});

document.getElementById('btn-token').addEventListener('click', function() {
  fetch(ccUrl('{{ gen_token }}')).then(function(r) { return r.json(); }).then(function(json) {
    if (json.token) { document.getElementById('input-token').value = json.token; }
  });
});

document.getElementById('btn-test').addEventListener('click', function() {
  var out = document.getElementById('test-result');
  out.innerHTML = '<span class="text-muted">…</span>';
  fetch(ccUrl('{{ test }}')).then(function(r) { return r.json(); }).then(function(json) {
    if (json.error) { out.innerHTML = '<span class="text-danger">' + json.error + '</span>'; }
    else { out.innerHTML = '<span class="text-success">' + json.success + '</span>'; }
  });
});

document.getElementById('btn-agent-check').addEventListener('click', function() {
  const box = document.getElementById('agent-check-result');
  box.textContent = '…';
  fetch(ccUrl('{{ agent_check }}')).then(function(r) { return r.json(); }).then(function(json) {
    box.textContent = '';
    if (json.error) {
      const warn = document.createElement('div');
      warn.className = 'alert alert-warning';
      warn.textContent = json.error;
      box.appendChild(warn);
      return;
    }
    const list = document.createElement('ul');
    list.className = 'list-unstyled';
    (json.results || []).forEach(function(r) {
      const li = document.createElement('li');
      const icon = document.createElement('i');
      icon.className = r.ok ? 'fa-solid fa-check text-success' : 'fa-solid fa-xmark text-danger';
      li.appendChild(icon);
      const note = r.note === 'https' ? {{ warning_ucp_https|json_encode }} : r.note;
      li.appendChild(document.createTextNode(' ' + (r.url || r.key) + ' — ' + (r.ok ? 'OK' : note)));
      list.appendChild(li);
    });
    box.appendChild(list);
  });
});

document.getElementById('btn-rebuild').addEventListener('click', function() {
  var alertBox = document.getElementById('alert-feeds');
  fetch(ccUrl('{{ rebuild }}')).then(function(r) { return r.json(); }).then(function(json) {
    if (json.error) { alertBox.innerHTML = '<div class="alert alert-danger">' + json.error + '</div>'; }
    else { alertBox.innerHTML = '<div class="alert alert-success">' + json.success + '</div>'; }
    window.scrollTo(0, 0);
  });
});
</script>
{{ footer }}
